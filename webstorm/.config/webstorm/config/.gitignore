# Ignore everything by default and explicitly allow portable IDE settings.
*
!.gitignore
!.gitkeep

# Editor and IDE configuration directories that are worth syncing.
!codestyles/
!codestyles/**
codestyles/Default.xml
!colors/
!colors/**
!fileTemplates/
!fileTemplates/**
!inspection/
!inspection/**
!keymaps/
!keymaps/**
!templates/
!templates/**
!options/

# Keep only global UI/editor settings from options/.
options/*
!options/colors.scheme.xml
!options/editor.xml
!options/ide.general.xml
!options/laf.xml
