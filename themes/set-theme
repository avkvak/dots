#!/bin/bash

theme_name="$1"
script_dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
builtin_themes_dir="$script_dir"
builtin_templates_dir="$script_dir/themed"
user_themes_dir="$HOME/.config/omarchy/themes"
user_templates_dir="$HOME/.config/omarchy/themed"
current_dir="$HOME/.config/omarchy/current"
current_theme_path="$current_dir/theme"
next_theme_path="$current_dir/next-theme"
theme_name_path="$current_dir/theme.name"
schedule_file="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/theme-schedule.conf"

hex_to_rgb() {
    local hex="${1#\#}"
    printf "%d,%d,%d" "0x${hex:0:2}" "0x${hex:2:2}" "0x${hex:4:2}"
}

normalize_hex_color() {
    local value="${1//[\"\' ]/}"

    case "$value" in
        \#*)
            printf '%s\n' "${value,,}"
            ;;
        0x*|0X*)
            printf '#%s\n' "${value:2}" | tr '[:upper:]' '[:lower:]'
            ;;
        *)
            printf '%s\n' "$value"
            ;;
    esac
}

can_use_gsettings() {
    command -v gsettings >/dev/null 2>&1 && [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]
}

update_schedule_theme() {
    local slot_name="$1"
    local slot_value="$2"
    local schedule_dir
    local temp_file
    local default_light="catppuccin-latte"
    local default_dark="kanagawa"

    schedule_dir="$(dirname "$schedule_file")"
    mkdir -p "$schedule_dir"

    if [[ ! -f "$schedule_file" ]]; then
        if [[ "$slot_name" == "light_theme" ]]; then
            default_light="$slot_value"
        else
            default_dark="$slot_value"
        fi

        cat > "$schedule_file" <<EOF
# Auto theme schedule for omarchy.
# Format: HH:MM in 24-hour time.

light_theme=$default_light
dark_theme=$default_dark
light_start=08:00
dark_start=19:00
EOF
        return 0
    fi

    temp_file=$(mktemp)
    awk -v slot_name="$slot_name" -v slot_value="$slot_value" '
        BEGIN { updated = 0 }
        index($0, slot_name "=") == 1 {
            print slot_name "=" slot_value
            updated = 1
            next
        }
        { print }
        END {
            if (!updated) {
                print slot_name "=" slot_value
            }
        }
    ' "$schedule_file" > "$temp_file"
    mv "$temp_file" "$schedule_file"
}

copy_theme_contents() {
    local source_path="$1"

    [[ -d "$source_path" ]] || return 0
    cp -r "$source_path"/. "$next_theme_path"/ 2>/dev/null
}

build_colors_file_from_alacritty() {
    local alacritty_file="$1"
    local output_file="$2"
    local section=""
    local line
    local key
    local value
    local normalized
    local map_key

    declare -A palette=()

    [[ -f "$alacritty_file" ]] || return 1

    while IFS= read -r line; do
        line="${line%"${line##*[![:space:]]}"}"
        line="${line#"${line%%[![:space:]]*}"}"
        [[ -n "$line" ]] || continue
        [[ "$line" == \#* ]] && continue

        if [[ "$line" =~ ^\[(.+)\]$ ]]; then
            section="${BASH_REMATCH[1]}"
            continue
        fi

        if [[ "$line" =~ ^([A-Za-z0-9_]+)[[:space:]]*=[[:space:]]*(.+)$ ]]; then
            key="${BASH_REMATCH[1]}"
            value="${BASH_REMATCH[2]}"
            normalized="$(normalize_hex_color "$value")"

            if [[ "$normalized" == \#* ]]; then
                map_key="${section}.${key}"
                palette["$map_key"]="$normalized"
            fi
        fi
    done < "$alacritty_file"

    local background="${palette[colors.primary.background]:-}"
    local foreground="${palette[colors.primary.foreground]:-}"
    local cursor="${palette[colors.cursor.cursor]:-${palette[colors.vi_mode_cursor.cursor]:-}}"
    local selection_background="${palette[colors.selection.background]:-${palette[colors.search.matches.background]:-}}"
    local selection_foreground="${palette[colors.selection.text]:-${foreground}}"
    local accent="${palette[colors.footer_bar.background]:-${cursor:-${palette[colors.normal.blue]:-${palette[colors.bright.blue]:-${selection_background:-}}}}}"

    [[ -n "$background" ]] || return 1
    [[ -n "$foreground" ]] || return 1
    [[ -n "$selection_background" ]] || selection_background="$background"
    [[ -n "$selection_foreground" ]] || selection_foreground="$foreground"
    [[ -n "$accent" ]] || accent="$selection_background"
    [[ -n "$cursor" ]] || cursor="$accent"

    cat > "$output_file" <<EOF
accent = "$accent"
cursor = "$cursor"
foreground = "$foreground"
background = "$background"
selection_foreground = "$selection_foreground"
selection_background = "$selection_background"
EOF
}

render_templates() {
    local colors_file="$next_theme_path/colors.toml"
    local temp_colors_file=""
    local alacritty_file="$next_theme_path/alacritty.toml"
    local sed_script

    if [[ ! -f "$colors_file" ]]; then
        temp_colors_file=$(mktemp)

        if build_colors_file_from_alacritty "$alacritty_file" "$temp_colors_file"; then
            colors_file="$temp_colors_file"
        else
            rm -f "$temp_colors_file"
            return 0
        fi
    fi

    sed_script=$(mktemp)

    while IFS='=' read -r key value; do
        key="${key//[\"\' ]/}"
        [[ -n "$key" ]] || continue
        [[ "$key" == \#* ]] && continue

        value="${value#*[\"\']}"
        value="${value%%[\"\']*}"

        printf 's|{{ %s }}|%s|g\n' "$key" "$value"
        printf 's|{{ %s_strip }}|%s|g\n' "$key" "${value#\#}"

        if [[ "$value" == \#* ]]; then
            printf 's|{{ %s_rgb }}|%s|g\n' "$key" "$(hex_to_rgb "$value")"
        fi
    done < "$colors_file" > "$sed_script"

    shopt -s nullglob
    for template_path in "$user_templates_dir"/*.tpl "$builtin_templates_dir"/*.tpl; do
        output_path="$next_theme_path/$(basename "$template_path" .tpl)"

        if [[ ! -f "$output_path" ]]; then
            sed -f "$sed_script" "$template_path" > "$output_path"
        fi
    done
    shopt -u nullglob

    rm -f "$sed_script"
    rm -f "$temp_colors_file"
}

if [[ -z "$theme_name" ]]; then
    echo "Usage: set-theme <theme-name>"
    exit 1
fi

if [[ "$theme_name" == "themed" ]]; then
    echo "Theme '$theme_name' does not exist"
    exit 1
fi

builtin_theme_path="$builtin_themes_dir/$theme_name"
user_theme_path="$user_themes_dir/$theme_name"

if [[ ! -d "$builtin_theme_path" ]] && [[ ! -d "$user_theme_path" ]]; then
    echo "Theme '$theme_name' does not exist"
    exit 1
fi

mkdir -p "$current_dir"

rm -rf "$next_theme_path"
mkdir -p "$next_theme_path"

copy_theme_contents "$builtin_theme_path"
copy_theme_contents "$user_theme_path"
render_templates

rm -rf "$current_theme_path"
mv "$next_theme_path" "$current_theme_path"
printf '%s\n' "$theme_name" > "$theme_name_path"

"$script_dir/set-next-bg.sh"

pi_theme=""

if [[ -f "$current_theme_path/light.mode" ]]; then
    if [[ "${OMARCHY_THEME_SOURCE:-manual}" != "auto" ]]; then
        update_schedule_theme "light_theme" "$theme_name"
    fi

    if can_use_gsettings; then
        gsettings set org.gnome.desktop.interface gtk-theme "Adwaita"
        gsettings set org.gnome.desktop.interface color-scheme "prefer-light"
    else
        echo "[set-theme] skipping gsettings theme update: no session bus"
    fi

    pi_theme="light"
else
    if [[ "${OMARCHY_THEME_SOURCE:-manual}" != "auto" ]]; then
        update_schedule_theme "dark_theme" "$theme_name"
    fi

    if can_use_gsettings; then
        gsettings set org.gnome.desktop.interface gtk-theme "Adwaita-dark"
        gsettings set org.gnome.desktop.interface color-scheme "prefer-dark"
    else
        echo "[set-theme] skipping gsettings theme update: no session bus"
    fi

    pi_theme="dark"
fi

gnome_icons_theme="$current_theme_path/icons.theme"
if [[ -f "$gnome_icons_theme" ]] && can_use_gsettings; then
    gsettings set org.gnome.desktop.interface icon-theme "$(<"$gnome_icons_theme")"
elif [[ -f "$gnome_icons_theme" ]]; then
    echo "[set-theme] skipping gsettings icon update: no session bus"
fi

# Toggle pi theme to match system theme
pi_settings="$HOME/.pi/agent/settings.json"
if [[ -n "$pi_theme" ]] && [[ -f "$pi_settings" ]] && command -v jq &>/dev/null; then
    if jq --arg theme "$pi_theme" '.theme = $theme' "$pi_settings" > "$pi_settings.tmp" 2>/dev/null && mv "$pi_settings.tmp" "$pi_settings"; then
        echo "[set-theme] pi theme set to '$pi_theme' (run '/reload' or restart pi to apply)"
    else
        echo "[set-theme] failed to set pi theme to '$pi_theme'"
    fi
else
    echo "[set-theme] pi theme not changed: settings file or jq not found"
fi

# Restart affected applications
killall -SIGUSR2 waybar 2>/dev/null || true

# Alacritty doesn't have reload signal, touch config to notify
touch ~/.config/alacritty/alacritty.toml
touch ~/.config/btop/btop.conf
touch ~/.config/btop/themes/current.theme

# Restart btop if running
pkill -SIGUSR2 btop 2>/dev/null || true

pkill swayosd-server 2>/dev/null || true
setsid swayosd-server >/dev/null 2>&1 &
timeout 2 swaync-client -R >/dev/null 2>&1 || true
timeout 2 swaync-client -rs >/dev/null 2>&1 || true

"$script_dir/set-browser-theme.sh"
