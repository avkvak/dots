// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
[
  {
    "label": "Create Commit Message",
    "command": "pi --no-session -p \"/commit-message\" | wl-copy",
    "reveal_target": "dock",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "on_success",
  },
  {
    "label": "Screenshot to Clipboard",
    "command": "adb exec-out screencap -p | wl-copy --type image/png",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "on_success",
  },
  {
    "label": "Toggle Niri Fullscreen",
    "command": "niri msg action maximize-column",
    "reveal": "no_focus",
    "use_new_terminal": false,
    "hide": "on_success",
  },
  {
    "label": "OpenCode Local",
    "command": "alacritty",
    "args": [
      "--working-directory",
      "$ZED_WORKTREE_ROOT",
      "-e",
      "opencode-local",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": true,
    "show_command": false,
    "reveal": "no_focus",
    "hide": "always",
    "reveal_target": "dock",
  },
  {
    "label": "pi",
    "command": "alacritty",
    "args": ["--working-directory", "$ZED_WORKTREE_ROOT", "-e", "pi"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": true,
    "show_command": false,
    "reveal": "no_focus",
    "hide": "always",
    "reveal_target": "dock",
  },
  {
    "label": "Gemini CLI",
    "command": "alacritty",
    "args": ["--working-directory", "$ZED_WORKTREE_ROOT", "-e", "gemini"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": true,
    "show_command": false,
    "reveal": "no_focus",
    "hide": "always",
    "reveal_target": "dock",
  },
]
