// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "base_keymap": "JetBrains",
  "agent": {
    "single_file_review": true,
    "default_model": {
      "provider": "ollama",
      "model": "kimi-k2.5:cloud",
      "enable_thinking": true,
    },
    "favorite_models": [
      {
        "provider": "OpenCode Zen",
        "model": "minimax-m2.5-free",
        "enable_thinking": false,
      },
      {
        "provider": "OpenCode Zen",
        "model": "glm-5-free",
        "enable_thinking": false,
      },
    ],
    "model_parameters": [],
  },
  "project_panel": {
    "dock": "left",
  },
  "git_panel": {
    "tree_view": false,
  },
  "agent_servers": {
    "opencode": {
      "favorite_models": [
        "openai/gpt-5.4/medium",
        "ollama/kimi-k2.5:cloud",
        "openai/gpt-5.4/high",
      ],
      "default_model": "ollama/kimi-k2.5:cloud",
      "type": "custom",
      "command": "opencode-local",
      "args": ["acp"],
      "env": {
        "OPENCODE_DISABLE_CHANNEL_DB": "1",
      },
    },
    "codex-acp": {
      "default_config_options": {
        "mode": "auto",
        "model": "gpt-5.4",
      },
      "type": "registry",
    },
  },
  "language_models": {
    "ollama": {
      "context_window": 200000,
    },
    "openai_compatible": {
      "OpenCode Zen": {
        "api_url": "https://opencode.ai/zen/v1",
        "available_models": [
          {
            "name": "big-pickle",
            "display_name": "big-pickle",
            "max_tokens": 256000,
            "capabilities": {
              "tools": true,
              "images": false,
              "prompt_cache_key": true,
              "parallel_tool_calls": false,
            },
          },
          {
            "name": "glm-4.7-free",
            "display_name": "GLM-4.7 Free",
            "max_tokens": 204800,
          },
          {
            "name": "glm-5-free",
            "display_name": "GLM-5 Free",
            "max_tokens": 204800,
          },
          {
            "name": "gpt-5-nano",
            "display_name": "GPT-5 Nano",
            "max_tokens": 400000,
            "capabilities": {
              "tools": true,
              "images": true,
              "prompt_cache_key": false,
              "parallel_tool_calls": false,
            },
          },
          {
            "name": "grok-code",
            "display_name": "Grok Code Fast 1",
            "max_tokens": 256000,
            "capabilities": {
              "tools": true,
              "images": true,
              "prompt_cache_key": false,
              "parallel_tool_calls": false,
            },
          },
          {
            "name": "kimi-k2.5-free",
            "display_name": "Kimi K2.5 Free",
            "max_tokens": 262144,
            "capabilities": {
              "tools": true,
              "images": true,
              "prompt_cache_key": false,
              "parallel_tool_calls": false,
            },
          },
          {
            "name": "minimax-m2.1-free",
            "display_name": "MiniMax M2.1 Free",
            "max_tokens": 204800,
          },
          {
            "name": "minimax-m2.5-free",
            "display_name": "MiniMax M2.5 Free",
            "max_tokens": 204800,
          },
          {
            "name": "trinity-large-preview-free",
            "display_name": "Trinity Large Preview",
            "max_tokens": 131072,
          },
          {
            "name": "glm-4.7",
            "display_name": "GLM 4.7 (Zen)",
            "max_tokens": 128000,
          },
        ],
      },
    },
  },
  "terminal": {
    "dock": "bottom",
  },
  "diagnostics": {
    "button": true,
    "include_warnings": true,
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "padding": 4,
      "min_column": 0,
      "max_severity": null,
    },
  },
  "edit_predictions": {
    "provider": "zed",
    "mode": "eager",
  },
  "ui_font_size": 12,
  "buffer_font_size": 12,
  "buffer_line_height": "standard",
  "agent_ui_font_size": 14,
  "ui_font_family": "Adwaita Sans",
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "theme": {
    "mode": "system",
    "dark": "Flexoki Dark",
    "light": "One Light",
  },
}
